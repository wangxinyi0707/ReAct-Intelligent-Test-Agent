# ===== Django 基础 =====
SECRET_KEY=change-me-to-a-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ===== MySQL（被测系统主库）=====
DB_NAME=tripgenius
DB_USER=root
DB_PASSWORD=password
DB_HOST=127.0.0.1
DB_PORT=3306

# ===== Redis（缓存 / Session / Celery broker）=====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ===== LLM：任意 OpenAI 兼容接口（示例为 DeepSeek）=====
# 测试 Agent / AI 用例生成 / 失败归因 / RAG 问答统一走该接口
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
# 历史遗留配置：当前 Embedding 使用本地模型 BAAI/bge-small-zh-v1.5，无需远端
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===== Chroma 向量库路径（构建 RAG 时自动创建）=====
CHROMA_PATH=rag_data/chroma_db

# ===== AI 测试 Agent：真实 HTTP 验证所用登录账号 =====
# Agent 的 execute_request 工具会用该账号换取 JWT 访问被测接口
AGENT_BASE_URL=http://127.0.0.1:8000
AGENT_USERNAME=demo_admin
AGENT_PASSWORD=admin12345
